+import React, { useState } from "react";
+import type { FlowNextStep } from "../utils/flow-next-step";
+
+/** Project Inbox：验收、退回、取消只在命令行里做；这里把该敲的命令直接给出来，点一下就能复制。 */
+const FlowNextStepPanel: React.FC<{ step: FlowNextStep }> = ({ step }) => {
+	const [feedback, setFeedback] = useState<{ command: string; text: string } | null>(null);
+
+	const copy = async (command: string, code: Element | null) => {
+		let text = "已复制";
+		try {
+			await navigator.clipboard.writeText(command);
+		} catch {
+			// 浏览器不让写剪贴板时不能提示成功：替用户选中整条命令，按复制键即可。
+			if (code) window.getSelection()?.selectAllChildren(code);
+			text = "已选中，请手动复制";
+		}
+		setFeedback({ command, text });
+		window.setTimeout(() => setFeedback((current) => (current?.command === command ? null : current)), 2000);
+	};
+
+	return (
+		<section
+			aria-label="下一步"
+			className="rounded-lg border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 p-4 transition-colors duration-200"
+		>
+			<h3 className="text-sm font-semibold text-amber-900 dark:text-amber-100">{step.title}</h3>
+			<p className="mt-1 text-sm text-amber-800 dark:text-amber-200">{step.detail}</p>
+			{step.commands.length > 0 && (
+				<ul className="mt-3 space-y-3">
+					{step.commands.map(({ label, command }) => (
+						<li key={command}>
+							<div className="text-xs text-amber-800 dark:text-amber-200">{label}</div>
+							<div className="mt-1 flex items-center gap-2">
+								<code className="min-w-0 flex-1 select-all overflow-x-auto whitespace-nowrap rounded border border-amber-200 dark:border-amber-800 bg-white dark:bg-gray-900 px-2 py-1.5 font-mono text-xs text-gray-900 dark:text-gray-100">
+									{command}
+								</code>
+								<button
+									type="button"
+									onClick={(event) => void copy(command, event.currentTarget.previousElementSibling)}
+									aria-label={`复制命令：${command}`}
+									className="shrink-0 rounded-md border border-amber-300 dark:border-amber-700 bg-white dark:bg-gray-800 px-2.5 py-1.5 text-xs font-medium text-amber-900 dark:text-amber-100 hover:bg-amber-100 dark:hover:bg-amber-900/40 focus:outline-none focus:ring-2 focus:ring-amber-500 transition-colors duration-200"
+								>
+									{feedback?.command === command ? feedback.text : "复制"}
+								</button>
+							</div>
+						</li>
+					))}
+				</ul>
+			)}
+		</section>
+	);
+};
+
+export default FlowNextStepPanel;
