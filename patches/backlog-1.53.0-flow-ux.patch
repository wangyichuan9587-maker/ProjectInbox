+/** Project Inbox：交接单流程里，这张卡现在等不等你处理、下一步做什么。只读任务字段，不发请求。 */
+import type { Task } from "../../types";
+
+export const HANDOFF_LABEL = "交接单";
+export const WAITING_LABEL = "待确认";
+
+export interface FlowCommand {
+	label: string;
+	command: string;
+}
+
+export interface FlowNextStep {
+	title: string;
+	detail: string;
+	commands: FlowCommand[];
+}
+
+type FlowTask = Pick<Task, "id" | "status" | "labels">;
+
+const normalize = (status: string | undefined) => (status ?? "").trim().toLowerCase();
+
+/** 只在需要用户动手的三种状态返回提示：待验收、受阻、收件箱里的待确认。其余状态不打扰。 */
+export function flowNextStep(task: FlowTask | null | undefined): FlowNextStep | null {
+	if (!task || !(task.labels ?? []).includes(HANDOFF_LABEL)) return null;
+	const status = normalize(task.status);
+	if (status === "review") {
+		return {
+			title: "等你验收",
+			detail: "汇报单和程序核验结果就在下面。看完后在终端运行其中一条：",
+			commands: [
+				{ label: "验收通过：快进合并到主分支，删除工作区", command: `project-inbox accept ${task.id}` },
+				{ label: "退回：原卡归档，生成沿用同一工作区的返工卡", command: `project-inbox reject ${task.id} --comment "写一句意见"` },
+			],
+		};
+	}
+	if (status === "blocked") {
+		return {
+			title: "卡住了，等你答复",
+			detail: `受阻原因见下面的汇报单。答复后，让讨论会话带上 task_id: ${task.id} 重新提交交接单，卡片回到待办并沿用同一个工作区。不做了就运行：`,
+			commands: [{ label: "取消：删除干净的工作区，分支保留，卡片归档", command: `project-inbox cancel ${task.id} --reason "写一句原因"` }],
+		};
+	}
+	if (status === "inbox" && (task.labels ?? []).includes(WAITING_LABEL)) {
+		return {
+			title: "还有问题没定，等你确认",
+			detail: `待确认的问题在下面的实施计划里。定下来后，让讨论会话带上 task_id: ${task.id} 重新提交交接单，卡片才会进入待办、可以被领取。`,
+			commands: [],
+		};
+	}
+	return null;
+}
+
+/** 汇报单里的受阻原因（「**受阻：** ……」那一行），没有就返回空字符串。 */
+export function blockedReason(finalSummary: string | undefined): string {
+	const match = /^\*\*受阻：\*\*[ \t]*(.+)$/m.exec(finalSummary ?? "");
+	return match?.[1]?.trim() ?? "";
+}
+
+/** 看板卡片上标签的颜色：需要用户处理的「待确认」用琥珀色，其余保持灰色。 */
+export function flowLabelClass(label: string): string {
+	return label === WAITING_LABEL
+		? "bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200"
+		: "bg-gray-100 dark:bg-gray-600 text-gray-600 dark:text-gray-300";
+}
